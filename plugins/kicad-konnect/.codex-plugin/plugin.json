{
  "name": "kicad-konnect",
  "version": "0.1.0",
  "description": "Konnect (KiCad MCP server) と KiCad 10 の CLI を Docker で動かし、回路図の生成 → ERC → 製造ファイル出力までを支援する",
  "author": { "name": "bols-blue" },
  "homepage": "https://github.com/bols-blue/konnect-kicad-docker",
  "repository": "https://github.com/bols-blue/konnect-kicad-docker",
  "keywords": ["kicad", "pcb", "schematic", "erc", "drc", "mcp"],
  "skills": "./skills/",
  "mcpServers": "./codex-mcp.json",
  "interface": {
    "displayName": "KiCad Konnect",
    "shortDescription": "KiCad 10 の回路図生成・ERC・製造ファイル出力",
    "developerName": "bols-blue",
    "category": "Developer Tools",
    "capabilities": ["Interactive", "Read", "Write"],
    "defaultPrompt": [
      "KiCad の回路図を作って ERC を通して"
    ]
  }
}
