+//! KiCad-native Specctra round trip (KiCad 10 ActionPlugin bridge).
+//!
+//! Konnect's own exporter (`specctra.rs`) deliberately supports a narrow board
+//! profile so that its reverse manifest can prove every imported track. Real
+//! boards routinely leave that profile (rounded-rectangle SMD pads, oval
+//! through-hole pads, NPTH pegs, arc outlines). This module backs the
+//! alternative route: KiCad itself writes the DSN and later imports the SES,
+//! exactly as File > Export/Import Specctra does in the PCB Editor.
+//!
+//! What Konnect still guarantees on this path is revision binding: the manifest
+//! records the SHA-256 of the IPC board snapshot the DSN was exported from, and
+//! the import refuses unless the live board is byte-identical to it, so a
+//! session routed for one revision is never applied to another.
+
+use anyhow::{bail, Context, Result};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::path::Path;
+
+pub(crate) const MANIFEST_KIND: &str = "konnect_kicad_native_specctra";
+pub(crate) const MANIFEST_VERSION: u32 = 1;
+pub(crate) const MAX_SES_BYTES: u64 = 512 * 1024 * 1024;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct NativeManifest {
+    pub kind: String,
+    pub version: u32,
+    /// Canonical path of the board the DSN was exported from.
+    pub board: String,
+    /// SHA-256 of the KiCad IPC board snapshot at export time.
+    pub source_sha256: String,
+    /// SHA-256 of the DSN text KiCad produced.
+    pub dsn_sha256: String,
+    /// Canonical-at-write path of the DSN file.
+    pub dsn_path: String,
+}
+
+pub(crate) fn sha256_hex(bytes: &[u8]) -> String {
+    let digest = Sha256::digest(bytes);
+    digest.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+pub(crate) fn build_manifest(board: &Path, source: &str, dsn: &str, dsn_path: &Path) -> NativeManifest {
+    NativeManifest {
+        kind: MANIFEST_KIND.to_string(),
+        version: MANIFEST_VERSION,
+        board: board.display().to_string(),
+        source_sha256: sha256_hex(source.as_bytes()),
+        dsn_sha256: sha256_hex(dsn.as_bytes()),
+        dsn_path: dsn_path.display().to_string(),
+    }
+}
+
+/// Parse a manifest and prove it belongs to `board` (already canonical).
+pub(crate) fn parse_manifest(text: &str, board: &Path) -> Result<NativeManifest> {
+    let manifest: NativeManifest =
+        serde_json::from_str(text).context("parse KiCad-native Specctra manifest")?;
+    if manifest.kind != MANIFEST_KIND || manifest.version != MANIFEST_VERSION {
+        bail!(
+            "manifest kind/version '{}'/{} is not a KiCad-native Specctra manifest (expected '{}'/{}); \
+             Konnect-exporter manifests are imported with apply_specctra_ses",
+            manifest.kind,
+            manifest.version,
+            MANIFEST_KIND,
+            MANIFEST_VERSION
+        );
+    }
+    if Path::new(&manifest.board) != board {
+        bail!(
+            "manifest was written for board '{}', not '{}'",
+            manifest.board,
+            board.display()
+        );
+    }
+    if manifest.source_sha256.len() != 64 || manifest.dsn_sha256.len() != 64 {
+        bail!("manifest digests are malformed");
+    }
+    Ok(manifest)
+}
+
+/// Counts of routed objects a Freerouting session carries, for reporting.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub(crate) struct SesStats {
+    pub wires: u64,
+    pub vias: u64,
+}
+
+/// Minimal structural check of a Specctra session before KiCad sees it.
+pub(crate) fn inspect_ses(text: &str) -> Result<SesStats> {
+    let trimmed = text.trim_start();
+    if !trimmed.starts_with("(session") {
+        bail!("file is not a Specctra session (expected a leading '(session')");
+    }
+    if !text.contains("(routes") {
+        bail!("Specctra session has no (routes ...) section");
+    }
+    let count = |needle: &str| text.matches(needle).count() as u64;
+    Ok(SesStats {
+        wires: count("(wire"),
+        vias: count("(via "),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn manifest_round_trips_and_binds_to_its_board() {
+        let board = Path::new("/work/demo/demo.kicad_pcb");
+        let manifest = build_manifest(board, "(kicad_pcb)", "(pcb demo)", Path::new("/work/demo/demo.dsn"));
+        let text = serde_json::to_string(&manifest).unwrap();
+        assert_eq!(parse_manifest(&text, board).unwrap(), manifest);
+        let other = Path::new("/work/other/other.kicad_pcb");
+        let error = parse_manifest(&text, other).unwrap_err().to_string();
+        assert!(error.contains("written for board"), "{error}");
+    }
+
+    #[test]
+    fn konnect_exporter_manifests_are_not_accepted() {
+        let board = Path::new("/work/demo/demo.kicad_pcb");
+        let mut manifest = build_manifest(board, "a", "b", Path::new("/work/demo/demo.dsn"));
+        manifest.kind = "konnect_specctra".to_string();
+        let error = parse_manifest(&serde_json::to_string(&manifest).unwrap(), board)
+            .unwrap_err()
+            .to_string();
+        assert!(error.contains("apply_specctra_ses"), "{error}");
+    }
+
+    #[test]
+    fn source_digest_changes_with_the_board_revision() {
+        let board = Path::new("/work/demo/demo.kicad_pcb");
+        let a = build_manifest(board, "(kicad_pcb rev1)", "d", Path::new("/d.dsn"));
+        let b = build_manifest(board, "(kicad_pcb rev2)", "d", Path::new("/d.dsn"));
+        assert_ne!(a.source_sha256, b.source_sha256);
+        assert_eq!(a.source_sha256.len(), 64);
+    }
+
+    #[test]
+    fn session_inspection_counts_wiring_and_rejects_non_sessions() {
+        let ses = "(session demo\n (routes\n  (network_out\n   (net GND\n    (wire (path F.Cu 2000 0 0 10 10))\n    (wire (path B.Cu 2000 10 10 20 20))\n    (via via0 10 10)\n   )\n  )\n )\n)\n";
+        assert_eq!(inspect_ses(ses).unwrap(), SesStats { wires: 2, vias: 1 });
+        assert!(inspect_ses("(pcb demo)").is_err());
+        assert!(inspect_ses("(session demo)").is_err());
+    }
+}
