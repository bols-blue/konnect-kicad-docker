+    /// Serve `responses` in order as `(status, body)` and hand back the port.
+    async fn mock_bridge(
+        responses: Vec<(u16, serde_json::Value)>,
+    ) -> (u16, tokio::task::JoinHandle<Vec<String>>) {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let server = tokio::spawn(async move {
+            let mut requests = Vec::new();
+            for (status, response) in responses {
+                let (mut stream, _) = listener.accept().await.unwrap();
+                let mut request = vec![0u8; 16 * 1024];
+                let count = stream.read(&mut request).await.unwrap();
+                requests.push(String::from_utf8_lossy(&request[..count]).to_string());
+                let body = response.to_string();
+                let reason = if status == 200 { "OK" } else { "Not Found" };
+                let reply = format!(
+                    "HTTP/1.1 {status} {reason}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}",
+                    body.len(), body
+                );
+                stream.write_all(reply.as_bytes()).await.unwrap();
+            }
+            requests
+        });
+        (port, server)
+    }
+
+    fn write_registration(root: &Path, port: u16) -> PathBuf {
+        std::fs::create_dir_all(root).unwrap();
+        let path = root.join("bridge-42.json");
+        std::fs::write(
+            &path,
+            serde_json::json!({
+                "protocol_version": 1,
+                "pid": 42,
+                "address": format!("http://127.0.0.1:{port}"),
+                "token": "t".repeat(32),
+                "started_at_unix": 1.0
+            })
+            .to_string(),
+        )
+        .unwrap();
+        path
+    }
+
+    fn status_ok() -> (u16, serde_json::Value) {
+        (
+            200,
+            serde_json::json!({
+                "success": true,
+                "protocol_version": 1,
+                "pid": 42,
+                "native_specctra_export": true
+            }),
+        )
+    }
+
+    #[tokio::test]
+    async fn authenticated_import_posts_board_and_session_and_reports_counts() {
+        let temp = tempfile::tempdir().unwrap();
+        let board = temp.path().join("board.kicad_pcb");
+        std::fs::write(&board, "(kicad_pcb)\n").unwrap();
+        let ses = temp.path().join("routed.ses");
+        std::fs::write(&ses, "(session routed (routes))\n").unwrap();
+        let board = board.canonicalize().unwrap();
+        let ses = ses.canonicalize().unwrap();
+        let (port, server) = mock_bridge(vec![
+            status_ok(),
+            (
+                200,
+                serde_json::json!({
+                    "success": true,
+                    "protocol_version": 1,
+                    "pid": 42,
+                    "board_path": board.display().to_string(),
+                    "ses_path": ses.display().to_string(),
+                    "ses_bytes": 26,
+                    "tracks_before": 0,
+                    "vias_before": 0,
+                    "tracks_after": 12,
+                    "vias_after": 3
+                }),
+            ),
+        ])
+        .await;
+        let registration = write_registration(&temp.path().join("native-bridge"), port);
+        let import = try_import_registration(&registration, &board, &ses)
+            .await
+            .unwrap();
+        let requests = server.await.unwrap();
+        assert!(requests[1].starts_with("POST /v1/import-specctra-ses"));
+        assert!(requests[1].contains(&ses.display().to_string()));
+        assert!(requests[1]
+            .to_ascii_lowercase()
+            .contains("authorization: bearer tttttttttttttttttttttttttttttttt"));
+        assert_eq!((import.tracks_after, import.vias_after), (12, 3));
+        assert_eq!(import.plugin_pid, 42);
+    }
+
+    #[tokio::test]
+    async fn import_reports_a_plugin_that_predates_session_import() {
+        let temp = tempfile::tempdir().unwrap();
+        let board = temp.path().join("board.kicad_pcb");
+        std::fs::write(&board, "(kicad_pcb)\n").unwrap();
+        let ses = temp.path().join("routed.ses");
+        std::fs::write(&ses, "(session routed (routes))\n").unwrap();
+        let (port, server) = mock_bridge(vec![
+            status_ok(),
+            (
+                404,
+                serde_json::json!({"success": false, "error": "unknown operation"}),
+            ),
+        ])
+        .await;
+        let registration = write_registration(&temp.path().join("native-bridge"), port);
+        let error = try_import_registration(&registration, &board, &ses)
+            .await
+            .unwrap_err()
+            .to_string();
+        server.await.unwrap();
+        assert!(error.contains("predates Specctra session import"), "{error}");
+    }
 }
