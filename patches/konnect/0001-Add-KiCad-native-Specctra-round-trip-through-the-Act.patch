+async fn handle_import_specctra_ses_native(
+    args: &serde_json::Value,
+    ctx: &ToolContext,
+) -> anyhow::Result<CallToolResult> {
+    let board = get_path(args, "board")?;
+    let ses_path = get_path(args, "ses_path")?;
+    let manifest_path = get_path(args, "manifest_path")?;
+    if !extension_is(&board, "kicad_pcb") {
+        return Ok(invalid_specctra_argument(
+            "board",
+            "must have the .kicad_pcb extension",
+        ));
+    }
+    if !extension_is(&ses_path, "ses") {
+        return Ok(invalid_specctra_argument(
+            "ses_path",
+            "must have the .ses extension",
+        ));
+    }
+    let board = board
+        .canonicalize()
+        .with_context(|| format!("resolve board {}", board.display()))?;
+    let ses_path = ses_path
+        .canonicalize()
+        .with_context(|| format!("resolve SES {}", ses_path.display()))?;
+    let ses_size = tokio::fs::metadata(&ses_path)
+        .await
+        .with_context(|| format!("inspect SES {}", ses_path.display()))?
+        .len();
+    if ses_size == 0 || ses_size > crate::native_specctra::MAX_SES_BYTES {
+        return Ok(invalid_specctra_argument(
+            "ses_path",
+            &format!("SES size {ses_size} is outside the supported range"),
+        ));
+    }
+    let ses_source = tokio::fs::read_to_string(&ses_path)
+        .await
+        .with_context(|| format!("read SES {}", ses_path.display()))?;
+    let stats = match crate::native_specctra::inspect_ses(&ses_source) {
+        Ok(stats) => stats,
+        Err(error) => return Ok(invalid_specctra_argument("ses_path", &format!("{error:#}"))),
+    };
+    let manifest_source = tokio::fs::read_to_string(&manifest_path)
+        .await
+        .with_context(|| format!("read manifest {}", manifest_path.display()))?;
+    let manifest = match crate::native_specctra::parse_manifest(&manifest_source, &board) {
+        Ok(manifest) => manifest,
+        Err(error) => {
+            return Ok(invalid_specctra_argument(
+                "manifest_path",
+                &format!("{error:#}"),
+            ))
+        }
+    };
+
+    let snapshot = |board: std::path::PathBuf, addr: String| async move {
+        crate::tools::with_ipc(addr, move |client| {
+            let document = client.find_open_board(&board)?;
+            client.save_document_to_string_in(document)
+        })
+        .await
+    };
+    let before = match snapshot(board.clone(), ctx.config.ipc_address.clone()).await? {
+        Ok(before) => before,
+        Err(reason) => {
+            return Ok(CallToolResult::error(format!(
+                "KiCad must be running with the board loaded (IPC error: {reason})"
+            )))
+        }
+    };
+    let live_sha256 = crate::native_specctra::sha256_hex(before.as_bytes());
+    if live_sha256 != manifest.source_sha256 {
+        return Ok(CallToolResult::error_kind(
+            ToolErrorKind::Conflict {
+                paths: vec![board.display().to_string()],
+            },
+            format!(
+                "live board revision {live_sha256} is not the exported revision {}; \
+                 the session was routed for a different board state. Re-export the DSN and route again.",
+                manifest.source_sha256
+            ),
+        ));
+    }
+
+    let attempt = crate::native_specctra_bridge::try_import_ses(&board, &ses_path).await;
+    let Some(import) = attempt.import else {
+        return Ok(CallToolResult::error(format!(
+            "KiCad-native Specctra session import did not run: {}",
+            attempt.diagnostics.join("; ")
+        )));
+    };
+    let after = match snapshot(board.clone(), ctx.config.ipc_address.clone()).await? {
+        Ok(after) => after,
+        Err(reason) => {
+            return Ok(CallToolResult::error(format!(
+                "session imported but the board could not be re-read over IPC: {reason}"
+            )))
+        }
+    };
+    Ok(CallToolResult::text(
+        json!({
+            "success": true,
+            "method": "kicad10_native_actionplugin",
+            "native_bridge_pid": import.plugin_pid,
+            "native_bridge_protocol_version": import.protocol_version,
+            "native_bridge_diagnostics": attempt.diagnostics,
+            "board": board,
+            "ses_path": ses_path,
+            "session": { "wires": stats.wires, "vias": stats.vias },
+            "board_before": { "tracks": import.tracks_before, "vias": import.vias_before },
+            "board_after": { "tracks": import.tracks_after, "vias": import.vias_after },
+            "source_sha256": manifest.source_sha256,
+            "result_sha256": crate::native_specctra::sha256_hex(after.as_bytes()),
+            "saved": false,
+            "next": "save_project, then run DRC (kicad-cli pcb drc --schematic-parity)"
+        })
+        .to_string(),
+    ))
+}
