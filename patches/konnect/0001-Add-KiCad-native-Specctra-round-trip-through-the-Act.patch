+async fn try_import_registration(
+    registration_path: &Path,
+    board: &Path,
+    ses_path: &Path,
+) -> Result<NativeImport> {
+    // KiCad's importer runs on the UI thread; the plugin allows it 120 s.
+    let (registration, client) = connect(registration_path, Duration::from_secs(125)).await?;
+    let board_text = board
+        .to_str()
+        .with_context(|| format!("board path is not UTF-8: {}", board.display()))?;
+    let ses_text = ses_path
+        .to_str()
+        .with_context(|| format!("SES path is not UTF-8: {}", ses_path.display()))?;
+    let response = client
+        .post(format!("{}/v1/import-specctra-ses", registration.address))
+        .bearer_auth(&registration.token)
+        .json(&ImportRequest {
+            expected_board: board_text,
+            ses_path: ses_text,
+        })
+        .send()
+        .await
+        .context("request native Specctra session import")?;
+    if response.status() == reqwest::StatusCode::NOT_FOUND {
+        bail!("native bridge plugin predates Specctra session import; update the Konnect ActionPlugin");
+    }
+    if !response.status().is_success() {
+        let status = response.status();
+        let detail = response
+            .json::<serde_json::Value>()
+            .await
+            .ok()
+            .and_then(|body| body["error"].as_str().map(str::to_string))
+            .unwrap_or_default();
+        bail!("native Specctra session import refused ({status}): {detail}");
+    }
+    let response: ImportResponse = response
+        .json()
+        .await
+        .context("parse native Specctra session import response")?;
+    validate_import_response(&registration, &response, board, ses_path)?;
+    Ok(NativeImport {
+        plugin_pid: response.pid,
+        protocol_version: response.protocol_version,
+        tracks_before: response.tracks_before,
+        vias_before: response.vias_before,
+        tracks_after: response.tracks_after,
+        vias_after: response.vias_after,
+    })
+}
+
+fn validate_import_response(
+    registration: &Registration,
+    response: &ImportResponse,
+    board: &Path,
+    ses_path: &Path,
+) -> Result<()> {
+    if !response.success
+        || response.protocol_version != registration.protocol_version
+        || response.pid != registration.pid
+        || response.ses_bytes == 0
+    {
+        bail!("native bridge import response is invalid");
+    }
+    let active_board = Path::new(&response.board_path)
+        .canonicalize()
+        .with_context(|| format!("resolve active bridge board {}", response.board_path))?;
+    let requested_board = board
+        .canonicalize()
+        .with_context(|| format!("resolve requested bridge board {}", board.display()))?;
+    if active_board != requested_board {
+        bail!(
+            "native bridge board '{}' does not match requested board '{}'",
+            active_board.display(),
+            requested_board.display()
+        );
+    }
+    if Path::new(&response.ses_path) != ses_path {
+        bail!(
+            "native bridge imported '{}' instead of requested session '{}'",
+            response.ses_path,
+            ses_path.display()
+        );
+    }
+    Ok(())
+}
