+fn default_native_specctra_manifest_path(output_path: &Path) -> PathBuf {
+    let mut name = output_path.as_os_str().to_os_string();
+    name.push(".konnect-native.json");
+    PathBuf::from(name)
+}
+
+async fn handle_export_specctra_dsn_native(
+    args: &serde_json::Value,
+    ctx: &ToolContext,
+) -> anyhow::Result<CallToolResult> {
+    let board_path = get_path(args, "board")?;
+    let output_path = get_path(args, "output")?;
+    let manifest_output_path = args["manifest_output_path"]
+        .as_str()
+        .map(PathBuf::from)
+        .unwrap_or_else(|| default_native_specctra_manifest_path(&output_path));
+
+    if !extension_is(&board_path, "kicad_pcb") {
+        return Ok(invalid_export_argument(
+            "board",
+            "must have the .kicad_pcb extension",
+        ));
+    }
+    if !extension_is(&output_path, "dsn") {
+        return Ok(invalid_export_argument(
+            "output",
+            "must have the .dsn extension",
+        ));
+    }
+    if output_path == manifest_output_path {
+        return Ok(invalid_export_argument(
+            "manifest_output_path",
+            "must not name the DSN output path",
+        ));
+    }
+    let conflicts = existing_export_targets(&[&output_path, &manifest_output_path]);
+    if !conflicts.is_empty() {
+        return Ok(CallToolResult::error_kind(
+            ToolErrorKind::Conflict {
+                paths: conflicts.clone(),
+            },
+            format!(
+                "Specctra export is non-destructive; remove or choose new output paths: {}",
+                conflicts.join(", ")
+            ),
+        ));
+    }
+    let board_path = board_path
+        .canonicalize()
+        .with_context(|| format!("resolve board {}", board_path.display()))?;
+
+    let snapshot = |board: PathBuf, addr: String| async move {
+        with_ipc(addr, move |client| {
+            let document = client.find_open_board(&board)?;
+            client.save_document_to_string_in(document)
+        })
+        .await
+    };
+    let before = match snapshot(board_path.clone(), ctx.config.ipc_address.clone()).await? {
+        Ok(before) => before,
+        Err(reason) => {
+            return Ok(CallToolResult::error_kind(
+                ToolErrorKind::HandlerError {
+                    reason: reason.clone(),
+                },
+                format!("KiCad-native Specctra export needs the board open in KiCad: {reason}"),
+            ));
+        }
+    };
+    let attempt = crate::native_specctra_bridge::try_export(&board_path).await;
+    let Some(native) = attempt.export else {
+        return Ok(CallToolResult::error(format!(
+            "KiCad 10 native Specctra bridge is unavailable (enable the Konnect ActionPlugin bridge in KiCad): {}",
+            attempt.diagnostics.join("; ")
+        )));
+    };
+    let after = match snapshot(board_path.clone(), ctx.config.ipc_address.clone()).await? {
+        Ok(after) => after,
+        Err(reason) => {
+            return Ok(CallToolResult::error(format!(
+                "KiCad board could not be re-read after native export: {reason}"
+            )));
+        }
+    };
+    if after != before {
+        return Ok(CallToolResult::error_kind(
+            ToolErrorKind::Conflict {
+                paths: vec![board_path.display().to_string()],
+            },
+            "KiCad board changed during native Specctra export; retry from a stable editor revision",
+        ));
+    }
+
+    let manifest =
+        crate::native_specctra::build_manifest(&board_path, &before, &native.dsn, &output_path);
+    let manifest_text = serde_json::to_string_pretty(&manifest)?;
+    let output_for_write = output_path.clone();
+    let manifest_for_write = manifest_output_path.clone();
+    let dsn_for_write = native.dsn.clone();
+    task::spawn_blocking(move || {
+        write_specctra_export_pair(
+            &output_for_write,
+            &dsn_for_write,
+            &manifest_for_write,
+            &manifest_text,
+        )
+    })
+    .await
+    .map_err(|error| anyhow::anyhow!("Specctra output writer panicked: {error}"))??;
+
+    let custom_rules = board_path.with_extension("kicad_dru");
+    let mut notes = Vec::new();
+    if custom_rules.is_file() {
+        notes.push(format!(
+            "custom DRC rules in {} are not part of a Specctra DSN; run DRC after importing the session",
+            custom_rules.display()
+        ));
+    }
+    Ok(CallToolResult::text(
+        json!({
+            "success": true,
+            "method": "kicad10_native_actionplugin",
+            "native_bridge_pid": native.plugin_pid,
+            "native_bridge_protocol_version": native.protocol_version,
+            "native_bridge_diagnostics": attempt.diagnostics,
+            "board": board_path,
+            "output": output_path,
+            "dsn_bytes": native.dsn.len(),
+            "manifest_output_path": manifest_output_path,
+            "source_sha256": manifest.source_sha256,
+            "notes": notes,
+            "next": "route_specctra_dsn, then import_specctra_ses_native with this manifest"
+        })
+        .to_string(),
+    ))
+}
