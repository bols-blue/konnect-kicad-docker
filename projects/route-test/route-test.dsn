(pcb route-test.kicad_pcb
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad Konnect)
    (host_version 0.12.1)
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0 100000 -120000 100000 -100000 130000 -100000 130000 -120000 100000 -120000)
    )
    (via konnect_via_0001)
    (rule
      (width 200)
      (clearance 200)
    )
  )
  (placement
    (component konnect_image_J1
      (place J1 104000 -107460 front 0)
    )
    (component konnect_image_R1
      (place R1 114000 -106000 front 0)
    )
    (component konnect_image_R2
      (place R2 114000 -114000 front 0)
    )
  )
  (library
    (image konnect_image_J1
      (pin konnect_pad_0003 1 0 0)
      (pin konnect_pad_0002 2 0 -2540)
      (pin konnect_pad_0002 3 0 -5080)
    )
    (image konnect_image_R1
      (pin konnect_pad_0001 1 0 0)
      (pin konnect_pad_0001 2 7620 0)
    )
    (image konnect_image_R2
      (pin konnect_pad_0001 1 0 0)
      (pin konnect_pad_0001 2 7620 0)
    )
    (padstack konnect_pad_0001
      (shape
        (circle F.Cu 1600)
      )
      (shape
        (circle B.Cu 1600)
      )
      (attach off)
    )
    (padstack konnect_pad_0002
      (shape
        (circle F.Cu 1700)
      )
      (shape
        (circle B.Cu 1700)
      )
      (attach off)
    )
    (padstack konnect_pad_0003
      (shape
        (rect F.Cu -850 -850 850 850)
      )
      (shape
        (rect B.Cu -850 -850 850 850)
      )
      (attach off)
    )
    (padstack konnect_via_0001
      (shape
        (circle F.Cu 600)
      )
      (shape
        (circle B.Cu 600)
      )
      (attach off)
    )
  )
  (network
    (net /GND
      (pins J1-3 R2-2)
    )
    (net /VIN
      (pins J1-1 R1-1)
    )
    (net /VOUT
      (pins J1-2 R1-2 R2-1)
    )
    (class konnect_class_0001 /GND /VIN /VOUT
      (circuit
        (use_via konnect_via_0001)
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring)
)
